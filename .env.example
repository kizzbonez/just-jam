# Copy to .env, or run `npm run env:init` to generate one with random secrets.

# --- Database -------------------------------------------------------------
POSTGRES_PASSWORD=change-me

# --- Web app --------------------------------------------------------------
# Signs session cookies and encrypts authenticator secrets. 32+ characters.
AUTH_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# The address people open in the browser.
APP_URL=http://127.0.0.1:3410
# Host port the studio is published on (always bound to 127.0.0.1).
WEB_PORT=3410
# Extra origins allowed to make state-changing requests, comma separated.
ALLOWED_ORIGINS=http://localhost:3410
# Optional fixed first-run token. Leave empty to have one generated and logged.
SETUP_TOKEN=

# --- QUIC relay -----------------------------------------------------------
# Shared by the web app and the relay: signs room tickets. 32+ characters.
RELAY_SHARED_SECRET=change-me-to-another-long-random-string-32-chars-min
# WebTransport endpoint as browsers reach it (HTTP/3, UDP).
RELAY_PUBLIC_URL=https://127.0.0.1:4433
# Host UDP port the relay is published on.
RELAY_PORT=4433
# Address that port is bound to. 127.0.0.1 keeps the relay on this machine.
# Set 0.0.0.0 only when players elsewhere must reach it: WebTransport is UDP,
# which HTTP tunnels (Cloudflare Tunnel included) do not carry.
RELAY_BIND=127.0.0.1
# WebSocket fallback for players who cannot reach the UDP port. Leave empty to
# turn the fallback off. It is plain HTTP on 127.0.0.1:RELAY_WS_PORT, so point
# an HTTPS tunnel or reverse proxy at that port and put its public address
# here, for example wss://relay.example.com
RELAY_WS_URL=
RELAY_WS_PORT=4434
# Links between players' browsers (WebRTC). With "on", browsers that can reach
# each other send audio straight to each other and skip the relay, which is the
# shortest path there is. Each player's public address is then visible to the
# others in the room. "off" keeps all audio on the relay.
P2P_MODE=on
# STUN servers a browser asks for its own public address, comma separated.
# Leave blank for the defaults (Google and Cloudflare). "none" uses no server,
# which limits links to players on the same network.
P2P_STUN_URLS=
# Names and addresses the relay's self-signed certificate should cover.
RELAY_CERT_HOSTS=127.0.0.1,localhost
